# Runtime-only overrides for the experimental native Linux user service.
# Main server settings live in ~/.config/ultravnc/uvnc-winvnc-linux-server.conf.
# State and log files are passed by the unit with the systemd user runtime dir.
UVNC_MAX_UPDATES=1024
