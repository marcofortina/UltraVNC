# Runtime-only overrides for the experimental native Linux user service.
# Main server settings live in ~/.config/ultravnc/uvnc-winvnc-linux-server.conf.
# State and log files are passed by the unit with the systemd user runtime dir.
UVNC_MAX_UPDATES=1024

# Linux admin equivalent notes:
# - Configuration lives in ~/.config/ultravnc/uvnc-winvnc-linux-server.conf.
# - Validate with uvnc_winvnc_memory_server --config ... --validate-config.
# - Inspect mapping with uvnc_winvnc_memory_server --config ... --print-admin-summary.
# - Runtime status/log/pid files are written under the systemd user runtime dir.
