[Unit]
Description=UltraVNC experimental native Linux WinVNC memory server
Documentation=file:@CMAKE_INSTALL_FULL_DATADIR@/ultravnc/linux/native-linux-server-backend-integration.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/ultravnc/uvnc-winvnc-memory-server.env
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/uvnc_winvnc_memory_server --bind-address ${UVNC_BIND_ADDRESS} --port ${UVNC_PORT} --name ${UVNC_DESKTOP_NAME} --capture-backend ${UVNC_CAPTURE_BACKEND} --input-backend ${UVNC_INPUT_BACKEND} --serve-updates --max-updates ${UVNC_MAX_UPDATES}
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=default.target
