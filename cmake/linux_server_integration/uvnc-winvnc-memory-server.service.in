[Unit]
Description=UltraVNC experimental native Linux WinVNC memory server
Documentation=file:@CMAKE_INSTALL_FULL_DATADIR@/ultravnc/linux/native-linux-server-backend-integration.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/ultravnc/uvnc-winvnc-memory-server.env
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/uvnc_winvnc_memory_server --config %h/.config/ultravnc/uvnc-winvnc-linux-server.conf --serve-forever --max-updates ${UVNC_MAX_UPDATES} --pid-file ${UVNC_PID_FILE} --status-file ${UVNC_STATUS_FILE}
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=default.target
