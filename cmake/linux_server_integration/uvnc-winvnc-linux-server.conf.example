# Conservative native Linux server runtime config.
# Copy to ~/.config/ultravnc/uvnc-winvnc-linux-server.conf and adjust per host.
#
# This sample is intentionally fail-closed: no authentication mode is enabled
# until the operator configures either VNCAuth or an explicit loopback lab
# no-auth override. For real use, configure auth=vnc-password first.

bind_address=127.0.0.1
port=5901
name=uvnc-linux-server
capture_backend=auto
input_backend=none
max_updates=1024
serve_updates=true


# Admin/status equivalents for the Windows service/tray/settings UI:
#
#   uvnc_winvnc_memory_server --config ~/.config/ultravnc/uvnc-winvnc-linux-server.conf --validate-config
#   uvnc_winvnc_memory_server --config ~/.config/ultravnc/uvnc-winvnc-linux-server.conf --print-admin-summary
#   systemctl --user status uvnc-winvnc-memory-server.service
#   cat "$XDG_RUNTIME_DIR/uvnc-winvnc-memory-server.status"
#
# The Linux path intentionally uses config files, systemd user services, status
# files and journal/log output instead of porting the Windows tray/settings UI.

# Recommended production baseline for this milestone:
#
#   install -m 0600 /dev/null ~/.config/ultravnc/vnc-password
#   printf '%s\n' 'secret1' > ~/.config/ultravnc/vnc-password
#
# Then uncomment and adjust the absolute password_file path:
#
# auth=vnc-password
# password_file=/home/USER/.config/ultravnc/vnc-password


# Optional native Linux DSM/SecureVNC provider ABI.
# Legacy Windows .dsm DLL loading is not supported.
#
# dsm_provider=/usr/local/lib/ultravnc/libuvnc-securevnc-provider.so

# Optional MSLogonII-style Linux authentication through an external helper.
# The helper receives UVNC_AUTH_METHOD, UVNC_AUTH_USERNAME and
# UVNC_AUTH_PASSWORD in its environment and must exit 0 to accept.
#
# auth=mslogon-ii
# auth_helper=/usr/local/libexec/uvnc-mslogon-auth

# VNCAuth is legacy RFB password authentication: max 8 bytes. For LAN/WAN
# exposure, prefer VeNCrypt/X509Vnc TLS transport instead of unencrypted VNCAuth.
# Generate/install private certificate material with 0600 permissions, then set:
#
# transport_security=vencrypt-x509-vnc
# tls_certificate_file=/home/USER/.config/ultravnc/server.crt
# tls_private_key_file=/home/USER/.config/ultravnc/server.key
#
# Non-loopback VNCAuth without TLS is still disabled by default and requires
# explicit allow_unencrypted_public=true only for controlled legacy/lab exposure.


# UltraVNC extended clipboard is enabled by default when a viewer advertises
# rfbEncodingExtendedClipboard. The Linux server currently exposes UTF-8 text
# with caps/notify/request/provide semantics and falls back to classic
# ServerCutText/ClientCutText for clients that do not advertise the extension.
# Disable only for legacy viewer debugging.
# extended_clipboard=true
# extended_clipboard_text_limit=10485760

# Local loopback/lab no-auth, not production:
# auth=none
# allow_no_auth=true

# Non-loopback VNCAuth without transport encryption is disabled by default.
# Only set this for explicit controlled exposure behind firewall/tunnel policy.
# allow_unencrypted_public=false

# Non-loopback no-auth requires both allow_no_auth=true and
# allow_public_no_auth=true and should only be used for controlled lab tests.
# allow_public_no_auth=false
